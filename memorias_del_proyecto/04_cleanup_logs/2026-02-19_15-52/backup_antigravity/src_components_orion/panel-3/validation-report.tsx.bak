"use client"

import { useBatch } from "./batch-context"
import { AlertTriangle, CheckCircle, Info, Activity, FileText, Settings, Ruler, Zap, Truck, Users } from "lucide-react"

export function ValidationReport() {
    const { vehicles, selectedVehicleId, approveVehicle } = useBatch()
    const vehicle = vehicles.find(v => v.id === selectedVehicleId)

    if (!vehicle) {
        return (
            <div className="h-full flex flex-col items-center justify-center text-slate-500 p-8">
                <div className="w-16 h-16 rounded-full bg-[#ffffff05] flex items-center justify-center mb-4">
                    <Info className="h-8 w-8 text-slate-600" />
                </div>
                <p className="text-sm text-center">Selecciona un vehículo de la tabla <br /> para ver el informe detallado.</p>
            </div>
        )
    }

    const { informe, estado_coherencia, estado_operativo } = vehicle
    const isCoherent = estado_coherencia === 'COHERENTE';
    const isApproved = estado_operativo === 'APROBADO';

    return (
        <div className="flex flex-col space-y-6 pb-10 font-sans text-slate-300">

            {/* BLOCK 1: Estado del Documento (Header) */}
            <div className={`p-5 rounded-xl border border-[#ffffff08] bg-[#ffffff02] relative overflow-hidden group
                ${isCoherent ? 'border-l-4 border-l-[#16C784]' : 'border-l-4 border-l-[#FFB020]'}`}>

                <div className="flex justify-between items-start z-10 relative">
                    <div>
                        <h2 className="text-4xl font-bold font-mono tracking-tighter text-white">
                            {vehicle.matricula}
                        </h2>
                        <div className="flex items-center gap-2 mt-2">
                            <span className={`text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider
                                ${isCoherent
                                    ? 'bg-[#16C784]/20 text-[#16C784]'
                                    : 'bg-[#FFB020]/20 text-[#FFB020]'}`}>
                                {estado_coherencia}
                            </span>
                            <span className="text-xs text-slate-500 bg-[#ffffff05] px-2 py-0.5 rounded">
                                Confianza OCR: <span className="text-white">{(vehicle.confianza_media * 100).toFixed(0)}%</span>
                            </span>
                        </div>
                    </div>

                    {/* Operational Action */}
                    <div className="flex flex-col items-end gap-2">
                        <span className={`text-xs font-mono px-2 py-1 rounded border
                            ${isApproved
                                ? 'border-[#3CE0FF]/30 text-[#3CE0FF] bg-[#3CE0FF]/10'
                                : 'border-slate-700 text-slate-500'}`}>
                            {estado_operativo}
                        </span>

                        {!isApproved && isCoherent && (
                            <button
                                onClick={() => approveVehicle(vehicle.id)}
                                className="bg-[#16C784] hover:bg-[#16C784]/90 text-black text-xs font-bold px-4 py-2 rounded transition-all shadow-[0_0_15px_rgba(22,199,132,0.2)]"
                            >
                                APROBAR VEHÍCULO
                            </button>
                        )}
                    </div>
                </div>
            </div>

            {/* BLOCK 2: Datos Reales (Resumen Humano) */}
            <section>
                <h3 className="text-[10px] uppercase tracking-widest text-[#3CE0FF] font-bold mb-3 flex items-center gap-2">
                    <FileText className="h-3 w-3" /> Ficha Resumen (Vista Humana)
                </h3>
                <div className="bg-[#ffffff03] p-4 rounded-lg border border-[#ffffff05]">
                    <div className="flex justify-between items-baseline mb-2">
                        <div className="text-lg font-medium text-white">
                            {vehicle.marca} <span className="text-slate-400">{vehicle.modelo}</span>
                        </div>
                        <div className="text-xs text-slate-500 font-mono">
                            1ª MAT: {vehicle.fecha_primera_matriculacion}
                        </div>
                    </div>

                    {/* Descripción Profesional */}
                    <div className="bg-[#0B1020] p-3 rounded border border-[#ffffff05] text-sm text-slate-300 leading-relaxed shadow-inner">
                        Vehículo tipo <strong>{vehicle.clasificacion_texto.split(' - ')[0]}</strong> ({vehicle.categoria_texto.split(' - ')[0] || "?"}) propulsado por <strong>{vehicle.combustible}</strong>.
                        Cuenta con un motor de <strong>{vehicle.cilindrada_l || "?"} L</strong> ({vehicle.potencia_cv || "?"} CV) y está homologado para <strong>{vehicle.plazas || "?"} plazas</strong>.
                        <br />
                        <span className="text-xs text-slate-500 mt-1 block">
                            Variante: {vehicle.tipo_var_ver || "No especificada"}
                        </span>
                    </div>
                </div>
            </section>

            {/* BLOCK 3: Clasificación y Características */}
            <section>
                <h3 className="text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-3 flex items-center gap-2">
                    <Settings className="h-3 w-3" /> Definición del Vehículo
                </h3>
                <div className="grid grid-cols-2 gap-3">
                    <div className="bg-[#ffffff03] p-3 rounded border border-[#ffffff05] space-y-1">
                        <span className="text-[10px] text-slate-500 uppercase flex items-center gap-1"><Truck className="h-3 w-3" /> Clasificación</span>
                        <div className="text-sm text-slate-300 leading-tight">
                            {vehicle.clasificacion_texto}
                        </div>
                        <div className="text-[10px] text-slate-600 font-mono mt-1">{vehicle.clasificacion_codigo}</div>
                    </div>
                    <div className="bg-[#ffffff03] p-3 rounded border border-[#ffffff05] space-y-1">
                        <span className="text-[10px] text-slate-500 uppercase flex items-center gap-1"><Settings className="h-3 w-3" /> Categoría / Carrocería</span>
                        <div className="text-sm text-slate-300 leading-tight">
                            {vehicle.categoria_texto} <br /> {vehicle.carroceria_texto}
                        </div>
                    </div>
                    <div className="bg-[#ffffff03] p-3 rounded border border-[#ffffff05] space-y-1 col-span-2 flex justify-between items-center">
                        <div className="flex items-center gap-4">
                            <div>
                                <span className="text-[10px] text-slate-500 uppercase block mb-1">Cilindrada</span>
                                <span className="text-sm text-white font-mono">{vehicle.cilindrada_l} L</span>
                            </div>
                            <div className="w-px h-8 bg-[#ffffff10]"></div>
                            <div>
                                <span className="text-[10px] text-slate-500 uppercase block mb-1">Potencia</span>
                                <span className="text-sm text-white font-mono">{vehicle.potencia_cv} CV</span>
                            </div>
                            <div className="w-px h-8 bg-[#ffffff10]"></div>
                            <div>
                                <span className="text-[10px] text-slate-500 uppercase block mb-1">Combustible</span>
                                <span className="text-sm text-white">{vehicle.combustible}</span>
                            </div>
                        </div>
                        <div className="text-right">
                            <span className="text-[10px] text-slate-500 uppercase block mb-1"><Users className="h-3 w-3 inline mr-1" />Plazas</span>
                            <span className="text-sm text-white font-mono px-2">{vehicle.plazas}</span>
                        </div>
                    </div>
                </div>
            </section>

            {/* BLOCK 4: Validaciones (Coherencia) */}
            <section>
                <h3 className="text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-3 flex items-center gap-2">
                    <Activity className="h-3 w-3" /> Estado de Validación
                </h3>
                <div className="border border-[#ffffff08] rounded-lg overflow-hidden text-xs">
                    <table className="w-full">
                        <thead className="bg-[#ffffff05] text-left">
                            <tr>
                                <th className="p-3 font-medium text-slate-400">Regla de Negocio</th>
                                <th className="p-3 font-medium text-slate-400 w-24 text-right">Resultado</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-[#ffffff05]">
                            {informe.coherence_rules.length === 0 ? (
                                <tr>
                                    <td colSpan={2} className="p-3 text-center text-slate-600 italic">
                                        Sin reglas aplicadas
                                    </td>
                                </tr>
                            ) : (
                                informe.coherence_rules.map((rule, idx) => (
                                    <tr key={idx} className="hover:bg-[#ffffff02]">
                                        <td className="p-3">
                                            <div className="text-slate-300">{rule.rule}</div>
                                            {rule.message && rule.status !== 'OK' && (
                                                <div className="text-[10px] text-red-400 mt-1 bg-red-900/10 p-1 rounded inline-block">
                                                    {rule.message}
                                                </div>
                                            )}
                                        </td>
                                        <td className="p-3 text-right">
                                            <span className={`text-[10px] font-bold px-2 py-0.5 rounded
                                                ${rule.status === 'OK'
                                                    ? 'bg-[#16C784]/10 text-[#16C784]'
                                                    : 'bg-red-500/10 text-red-500'}`}>
                                                {rule.status}
                                            </span>
                                        </td>
                                    </tr>
                                ))
                            )}
                        </tbody>
                    </table>
                </div>
            </section>

            {/* BLOCK 5: Apartado Técnico (Tabla Trazable) */}
            <section>
                <h3 className="text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-3 flex items-center gap-2">
                    <Ruler className="h-3 w-3" /> Ficha Técnica (Extracción OCR)
                </h3>
                <div className="border border-[#ffffff08] rounded-lg overflow-hidden text-xs">
                    <table className="w-full table-fixed">
                        <thead className="bg-[#ffffff05] text-left">
                            <tr>
                                <th className="p-2 font-medium text-slate-400 w-1/3">Campo</th>
                                <th className="p-2 font-medium text-slate-400 w-1/3">Valor</th>
                                <th className="p-2 font-medium text-slate-400 w-1/6">Origen</th>
                                <th className="p-2 font-medium text-slate-400 w-1/6 text-right">Conf.</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-[#ffffff05]">
                            {informe.technical_fields.map((field, idx) => (
                                <tr key={idx} className="hover:bg-[#ffffff02]">
                                    <td className="p-2 text-slate-400 truncate">
                                        <div className="font-medium text-slate-300 truncate" title={field.label}>{field.label}</div>
                                        <div className="text-[9px] text-slate-600 font-mono">{field.field}</div>
                                    </td>
                                    <td className="p-2 font-mono text-[#3CE0FF] font-medium truncate" title={String(field.value)}>
                                        {field.value ?? "-"}
                                    </td>
                                    <td className="p-2 text-slate-500 text-[10px]">
                                        {field.source_key}
                                    </td>
                                    <td className="p-2 text-right">
                                        {field.is_derived ? (
                                            <span className="text-[9px] bg-blue-500/10 text-blue-400 px-1 rounded">CALC</span>
                                        ) : (
                                            <span className={`text-[9px] ${field.confidence > 0.8 ? 'text-[#16C784]' : 'text-[#FFB020]'}`}>
                                                {(field.confidence * 100).toFixed(0)}%
                                            </span>
                                        )}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>

            {/* BLOCK 6: Observaciones */}
            {informe.observations && informe.observations.length > 0 && (
                <section>
                    <h3 className="text-[10px] uppercase tracking-widest text-[#FFB020] font-bold mb-3 flex items-center gap-2">
                        <AlertTriangle className="h-3 w-3" /> Observaciones
                    </h3>
                    <div className="bg-[#FFB020]/5 border border-[#FFB020]/20 rounded p-4">
                        <ul className="list-disc list-inside text-xs text-[#FFB020] space-y-1">
                            {informe.observations.map((obs, idx) => (
                                <li key={idx}>{obs}</li>
                            ))}
                        </ul>
                    </div>
                </section>
            )}

            {/* BLOCK 7: Operational (Implicit in Header, but can be explicit if needed) */}
            <div className="text-center pt-4 border-t border-[#ffffff05]">
                <p className="text-xs text-slate-500 uppercase tracking-widest mb-1">Resultado Operativo</p>
                <div className={`text-sm font-bold ${isApproved ? 'text-[#3CE0FF]' : 'text-slate-400'}`}>
                    {estado_operativo === 'APROBADO' ? 'LISTO PARA EXPORTAR' : 'REQUIERE REVISIÓN MANUAL'}
                </div>
            </div>

        </div>
    )
}
