{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["meta", "anchors"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["country", "system", "letters_alphabet"],
      "properties": {
        "country": { "type": "string" },
        "system": { "type": "string" },
        "letters_alphabet": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1 }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "date", "series"],
        "properties": {
          "kind": { "type": "string", "enum": ["month_end", "observed"] },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "series": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
