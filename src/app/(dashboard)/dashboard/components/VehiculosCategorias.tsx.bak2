"use client";

import React, { useState, useCallback, useEffect } from 'react';
import { createPortal } from 'react-dom';

export type TipologiaStat = {
  tipologia: string;
  estudio: number;
  ofertada: number;
  contratada: number;
  total: number;
};

export type CatStats = {
  categoria: string;
  subtitulo: string;
  tipologias: TipologiaStat[];
  estudio: number;
  ofertada: number;
  contratada: number;
  total: number;
};

const sectionStyle: React.CSSProperties = {
  paddingTop: 28,
  borderTop: '1px solid var(--t-line)',
};

const CAT_COLORS = ['#4387ff', '#7c5cfc', '#20c982', '#ef4d5a'];
const CAT_ACCENT = ['#1240cc', '#6366f1', '#10b981', '#6b7280'];

// ─── PDF logo helper ──────────────────────────────────────────────────────────

async function fetchLogoDataUrl(): Promise<string> {
  try {
    const res = await fetch('/ORION_LOGO.png');
    const buf = await res.arrayBuffer();
    const bytes = new Uint8Array(buf);
    let bin = '';
    bytes.forEach(b => { bin += String.fromCharCode(b); });
    return 'data:image/png;base64,' + btoa(bin);
  } catch {
    return '';
  }
}

// ─── PDF HTML builder ─────────────────────────────────────────────────────────

function buildPdfHtml(stats: CatStats[], fecha: string, logoSrc: string): string {
  const totalAll   = stats.reduce((s, c) => s + c.total, 0);
  const totalContr = stats.reduce((s, c) => s + c.contratada, 0);
  const totalEst   = stats.reduce((s, c) => s + c.estudio, 0);
  const tasa = totalAll > 0 ? Math.round((totalContr / totalAll) * 100) : 0;

  const logoTag = logoSrc
    ? `<img src="${logoSrc}" alt="ORION" style="width:26px;height:26px;object-fit:contain;filter:brightness(0);flex-shrink:0;">`
    : `<svg width="26" height="26" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0"><path d="M17.5 3.3 29.5 9.1 29.5 23.3 17.4 31.4 5.1 24.5 5.1 10.4Z" fill="none" stroke="#15171b" stroke-linejoin="round" stroke-width="3"/><path d="M8.3 23.2 22.2 15.1M23.2 3.9 32.9 8.8 32.9 16.7M19.5 29.8 29.4 24.1" fill="none" stroke="#15171b" stroke-linecap="round" stroke-width="3"/></svg>`;

  const catRows = stats.map(c => {
    const t   = c.total > 0 ? Math.round((c.contratada / c.total) * 100) : 0;
    const pct = totalAll > 0 ? Math.round((c.total / totalAll) * 100) : 0;
    return `<tr>
      <td class="tdl"><strong>${c.categoria}</strong><br><small class="faint">${c.subtitulo}</small></td>
      <td class="tdc">${c.estudio}</td>
      <td class="tdc">${c.ofertada}</td>
      <td class="tdc">${c.contratada}</td>
      <td class="tdc bold">${c.total}</td>
      <td class="tdc">${pct}%</td>
      <td class="tdc accent bold">${t}%</td>
    </tr>`;
  }).join('');

  const detailBlocks = stats.map((c, i) => {
    const t = c.total > 0 ? Math.round((c.contratada / c.total) * 100) : 0;
    const tipRows = c.tipologias.map(tip => {
      const pct = c.total > 0 ? Math.round((tip.total / c.total) * 100) : 0;
      return `<tr>
        <td class="tdl">${tip.tipologia}</td>
        <td class="tdc">${tip.estudio}</td>
        <td class="tdc">${tip.ofertada}</td>
        <td class="tdc">${tip.contratada}</td>
        <td class="tdc bold">${tip.total}</td>
        <td class="tdc">${pct}%</td>
      </tr>`;
    }).join('');
    return `<div class="cat-block">
      <div class="cat-head" style="border-left-color:${CAT_ACCENT[i] ?? '#1240cc'}">
        <strong class="cat-name">${c.categoria}</strong>
        <span class="faint">${c.total} vehículos · ${t}% contratación</span>
      </div>
      <table>
        <thead><tr>
          <th class="thl">Tipología</th>
          <th class="thc">En estudio</th>
          <th class="thc">Ofertados</th>
          <th class="thc">Contratados</th>
          <th class="thc">Total</th>
          <th class="thc">% s/ cat.</th>
        </tr></thead>
        <tbody>${tipRows}</tbody>
      </table>
    </div>`;
  }).join('');

  return `<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8">
<title>Informe — Vehículos por Categoría · ORION</title>
<style>
@page{size:A4;margin:14mm 16mm 14mm}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,'Segoe UI',Arial,sans-serif;font-size:12px;color:#15171b;background:#fff;line-height:1.45}
.wrap{max-width:780px;margin:0 auto}
.rhead{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px;padding-bottom:16px;border-bottom:2px solid #15171b}
.wordmark{display:flex;align-items:center;gap:10px}
.orion-name{font-size:15px;font-weight:780;letter-spacing:.11em;color:#15171b}
.rt{text-align:right}
.rtitle{font-size:14px;font-weight:700;color:#15171b;margin-bottom:3px}
.rmeta{font-size:10px;color:#555D69}
.kpis{display:flex;border:1px solid #dfe3e8;border-radius:6px;overflow:hidden;margin-bottom:22px}
.kpi{flex:1;padding:14px 16px;border-right:1px solid #dfe3e8}
.kpi:last-child{border-right:none}
.lbl{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#9aa1aa;display:block;margin-bottom:4px}
.val{font-size:26px;font-weight:760;letter-spacing:-.04em;color:#15171b;display:block;line-height:1.1}
.sub{font-size:10px;color:#9aa1aa;display:block;margin-top:2px}
.accent{color:#1240cc}
.st{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#555D69;border-bottom:1px solid #dfe3e8;padding-bottom:5px;margin:20px 0 12px}
table{width:100%;border-collapse:collapse;margin-bottom:16px;font-size:12px}
th{font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#9aa1aa;padding:7px 10px;border-bottom:1px solid #dfe3e8;font-weight:600}
.thl{text-align:left}
.thc{text-align:center}
td{padding:9px 10px;border-bottom:1px solid #f0f2f5;color:#15171b}
tr:last-child td{border-bottom:none}
.tdl{text-align:left;font-size:12px}
.tdc{text-align:center;font-size:12px}
.bold{font-weight:700}
.faint{color:#9aa1aa;font-size:10px}
.cat-block{margin-bottom:20px;break-inside:avoid}
.cat-head{display:flex;justify-content:space-between;align-items:center;padding:7px 12px;border-left:3px solid #1240cc;background:#f7f9fc;margin-bottom:8px}
.cat-name{font-size:12px;font-weight:700;color:#15171b}
.metabox{background:#f7f9fc;border:1px solid #dfe3e8;border-radius:6px;padding:14px 16px;margin-top:16px}
.mbt{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#9aa1aa;margin-bottom:10px}
.mgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px 20px}
.ml{font-size:11px;font-weight:600;color:#15171b;margin-bottom:2px}
.mc{font-size:10px;font-family:monospace;background:#edf0f7;padding:2px 6px;border-radius:3px;display:inline-block;color:#1240cc}
.md{font-size:9px;color:#9aa1aa;margin-top:2px}
.footer{margin-top:20px;padding-top:10px;border-top:1px solid #dfe3e8;display:flex;justify-content:space-between;font-size:9px;color:#9aa1aa}
@media print{body{background:#fff}.wrap{max-width:100%}}
</style>
</head><body>
<div class="wrap">

<div class="rhead">
  <div class="wordmark">
    ${logoTag}
    <span class="orion-name">ORION</span>
  </div>
  <div class="rt">
    <div class="rtitle">Informe — Vehículos por Categoría</div>
    <div class="rmeta">${fecha} · Análisis global del período</div>
  </div>
</div>

<div class="kpis">
  <div class="kpi"><span class="lbl">Total vehículos</span><span class="val">${totalAll}</span><span class="sub">todos los estudios</span></div>
  <div class="kpi"><span class="lbl">En estudio</span><span class="val">${totalEst}</span><span class="sub">${totalAll > 0 ? Math.round(totalEst / totalAll * 100) : 0}% del total</span></div>
  <div class="kpi"><span class="lbl">Contratados</span><span class="val">${totalContr}</span><span class="sub">${totalAll > 0 ? Math.round(totalContr / totalAll * 100) : 0}% del total</span></div>
  <div class="kpi"><span class="lbl">Tasa contratación</span><span class="val accent">${tasa}%</span><span class="sub">sobre total vehículos</span></div>
</div>

<div class="st">Resumen por categoría</div>
<table>
  <thead><tr>
    <th class="thl">Categoría</th>
    <th class="thc">En estudio</th>
    <th class="thc">Ofertados</th>
    <th class="thc">Contratados</th>
    <th class="thc">Total</th>
    <th class="thc">Distribución</th>
    <th class="thc">Tasa contr.</th>
  </tr></thead>
  <tbody>${catRows}</tbody>
</table>

<div class="st">Detalle por tipología</div>
${detailBlocks}

<div class="metabox">
  <div class="mbt">Cómo se calculan los porcentajes</div>
  <div class="mgrid">
    <div><div class="ml">Tasa contratación (KPI global)</div><div class="mc">contratados / total_vehículos × 100</div><div class="md">Ej: ${totalContr} / ${totalAll} = ${tasa}%</div></div>
    <div><div class="ml">Tasa contr. por categoría</div><div class="mc">contratados_cat / total_cat × 100</div><div class="md">Solo vehículos de esa categoría</div></div>
    <div><div class="ml">Distribución (% s/ cat.)</div><div class="mc">total_tip / total_cat × 100</div><div class="md">Peso de la tipología dentro de su categoría</div></div>
    <div><div class="ml">Fuente de datos</div><div class="mc">trabajoRows de todas las carpetas</div><div class="md">Por tipo_vehiculo · sin tipo → Sin clasificar</div></div>
  </div>
</div>

<div class="footer">
  <span>ORION · ${fecha}</span>
  <span>Datos: todas las carpetas del período</span>
</div>

</div>
</body></html>`;
}

// ─── SecTitle (modal preview) ─────────────────────────────────────────────────

function SecTitle({ children }: { children: React.ReactNode }) {
  return (
    <div style={{
      fontSize: 10, fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.12em',
      color: '#555D69', borderBottom: '1px solid #dfe3e8', paddingBottom: 6,
      marginTop: 24, marginBottom: 12,
    }}>
      {children}
    </div>
  );
}

// ─── VehiculosCategorias ──────────────────────────────────────────────────────

export default function VehiculosCategorias({ stats }: { stats: CatStats[] }) {
  const [open, setOpen] = useState(false);

  const handlePdf = useCallback(async () => {
    const fecha = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
    const logoSrc = await fetchLogoDataUrl();
    const win = window.open('', '_blank');
    if (!win) return;
    win.document.write(buildPdfHtml(stats, fecha, logoSrc));
    win.document.close();
    win.onload = () => { setTimeout(() => win.print(), 300); };
  }, [stats]);

  useEffect(() => {
    if (!open) return;
    const handler = (e: KeyboardEvent) => { if (e.key === 'Escape') setOpen(false); };
    document.addEventListener('keydown', handler);
    return () => document.removeEventListener('keydown', handler);
  }, [open]);

  const visibleStats = stats.filter(c => c.categoria !== 'Sin clasificar');
  const totalVeh   = stats.reduce((s, c) => s + c.total, 0);
  const totalContr = stats.reduce((s, c) => s + c.contratada, 0);
  const totalEst   = stats.reduce((s, c) => s + c.estudio, 0);

  const thStyle: React.CSSProperties = {
    padding: '0 0 12px 0', fontSize: 10, fontWeight: 700,
    textTransform: 'uppercase', letterSpacing: '0.12em',
    color: 'var(--t-text-3)', borderBottom: '1px solid var(--t-line)',
    textAlign: 'left',
  };

  return (
    <>
      {/* ── Sección integrada ── */}
      <div style={sectionStyle}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 }}>
          <button
            onClick={() => setOpen(true)}
            style={{ display: 'flex', alignItems: 'center', gap: 8, background: 'none', border: 'none', padding: 0, cursor: 'pointer' }}
          >
            <h2 style={{ fontSize: 16, fontWeight: 620, color: 'var(--t-text)', margin: 0, pointerEvents: 'none' }}>
              Vehículos por categoría
            </h2>
            <span style={{ fontSize: 12, color: 'var(--t-blue)', opacity: 0.8, whiteSpace: 'nowrap' }}>
              Ver informe →
            </span>
          </button>
          {totalVeh > 0 && (
            <span style={{ fontSize: 11, color: 'var(--t-text-3)', letterSpacing: '0.06em' }}>
              {totalVeh.toLocaleString('es')} vehículos
            </span>
          )}
        </div>

        {totalVeh === 0 ? (
          <p style={{ color: 'var(--t-text-3)', fontSize: 12, textAlign: 'center', padding: '40px 0', margin: 0 }}>Sin datos</p>
        ) : (
          <div style={{ overflowX: 'auto' }}>
            <table style={{ width: '100%', borderCollapse: 'collapse', tableLayout: 'fixed', minWidth: 520, fontFamily: 'inherit' }}>
              <colgroup>
                <col style={{ width: 180 }} />
                <col style={{ width: 160 }} />
                <col style={{ width: 90 }} />
                <col style={{ width: 105 }} />
                <col style={{ width: 72 }} />
              </colgroup>
              <thead>
                <tr>
                  <th style={thStyle}>Categoría</th>
                  <th style={{ ...thStyle, textAlign: 'center' }}>Distribución</th>
                  <th style={{ ...thStyle, textAlign: 'center' }}>En estudio</th>
                  <th style={{ ...thStyle, textAlign: 'center' }}>Contratados</th>
                  <th style={{ ...thStyle, textAlign: 'center' }}>Total</th>
                </tr>
              </thead>
              <tbody>
                {visibleStats.map((c, i) => {
                  const pct = totalVeh > 0 ? Math.round((c.total / totalVeh) * 100) : 0;
                  return (
                    <tr
                      key={c.categoria}
                      onClick={() => setOpen(true)}
                      style={{ cursor: 'pointer' }}
                    >
                      <td style={{ padding: '16px 0', borderBottom: '1px solid var(--t-line-soft)', verticalAlign: 'middle' }}>
                        <div
                          style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text)' }}
                          onMouseEnter={e => { e.currentTarget.style.color = 'var(--t-blue)'; }}
                          onMouseLeave={e => { e.currentTarget.style.color = 'var(--t-text)'; }}
                        >
                          {c.categoria}
                        </div>
                        <div style={{ fontSize: 11, color: 'var(--t-text-2)', marginTop: 2 }}>{c.subtitulo}</div>
                      </td>
                      <td style={{ padding: '16px 0 16px 2px', borderBottom: '1px solid var(--t-line-soft)', textAlign: 'center', verticalAlign: 'middle' }}>
                        <div style={{ display: 'inline-flex', alignItems: 'center', gap: 7 }}>
                          <div style={{ width: 80, height: 4, background: 'var(--t-line)', borderRadius: 2, flexShrink: 0, overflow: 'hidden' }}>
                            <div style={{ width: `${pct}%`, height: '100%', background: CAT_COLORS[i] ?? '#4387ff' }} />
                          </div>
                          <span style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text-2)', whiteSpace: 'nowrap' }}>{pct}%</span>
                        </div>
                      </td>
                      <td style={{ padding: '16px 0', borderBottom: '1px solid var(--t-line-soft)', textAlign: 'center', verticalAlign: 'middle' }}>
                        <span style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text)' }}>{c.estudio}</span>
                      </td>
                      <td style={{ padding: '16px 0', borderBottom: '1px solid var(--t-line-soft)', textAlign: 'center', verticalAlign: 'middle' }}>
                        <span style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text)' }}>{c.contratada}</span>
                      </td>
                      <td style={{ padding: '16px 0', borderBottom: '1px solid var(--t-line-soft)', textAlign: 'center', verticalAlign: 'middle' }}>
                        <span style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text-2)' }}>{c.total}</span>
                      </td>
                    </tr>
                  );
                })}
                <tr>
                  <td style={{ padding: '12px 0', borderTop: '1px solid var(--t-line)' }}>
                    <span style={{ fontSize: 11, letterSpacing: '0.08em', textTransform: 'uppercase', color: 'var(--t-text-3)' }}>Total</span>
                  </td>
                  <td style={{ padding: '12px 0', borderTop: '1px solid var(--t-line)' }} />
                  <td style={{ padding: '12px 0', borderTop: '1px solid var(--t-line)', textAlign: 'center' }}>
                    <span style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text)' }}>{totalEst}</span>
                  </td>
                  <td style={{ padding: '12px 0', borderTop: '1px solid var(--t-line)', textAlign: 'center' }}>
                    <span style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text)' }}>{totalContr}</span>
                  </td>
                  <td style={{ padding: '12px 0', borderTop: '1px solid var(--t-line)', textAlign: 'center' }}>
                    <span style={{ fontSize: 14, fontWeight: 600, color: 'var(--t-text-2)' }}>{totalVeh}</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* ── Modal informe completo — renderizado en document.body (portal) ── */}
      {open && createPortal(
        <div
          onClick={e => { if (e.target === e.currentTarget) setOpen(false); }}
          style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.72)', zIndex: 9999, display: 'flex', alignItems: 'flex-start', justifyContent: 'center', padding: '32px 24px', overflowY: 'auto', backdropFilter: 'blur(4px)' }}
        >
          <div style={{ background: '#fff', borderRadius: 12, maxWidth: 860, width: '100%', overflow: 'hidden', boxShadow: '0 24px 80px rgba(0,0,0,0.45)', marginBottom: 32, fontFamily: 'Inter, -apple-system, sans-serif' }}>

            {/* ── Header ORION Reports ── */}
            <div style={{ padding: '22px 32px 18px', borderBottom: '2px solid #15171b', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 16 }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 10, flexShrink: 0 }}>
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img src="/ORION_LOGO.png" alt="ORION" style={{ width: 26, height: 26, objectFit: 'contain', filter: 'brightness(0)', flexShrink: 0 }} />
                <span style={{ fontSize: 15, fontWeight: 780, letterSpacing: '0.11em', color: '#15171b' }}>ORION</span>
              </div>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: 14, fontWeight: 700, color: '#15171b' }}>Informe — Vehículos por Categoría</div>
                <div style={{ fontSize: 10, color: '#555D69', marginTop: 2 }}>
                  {new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })} · Análisis global del período
                </div>
              </div>
              <div style={{ display: 'flex', gap: 8, flexShrink: 0 }}>
                <button
                  onClick={handlePdf}
                  style={{ display: 'inline-flex', alignItems: 'center', gap: 6, background: '#15171b', border: 'none', color: '#fff', fontSize: 12, fontWeight: 600, padding: '8px 14px', borderRadius: 6, cursor: 'pointer', letterSpacing: '0.03em' }}
                >
                  <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                    <path d="M6.5 1v8M3 6.5l3.5 3.5L10 6.5" stroke="white" strokeWidth="1.5" strokeLinecap="round" />
                    <path d="M1.5 11.5h10" stroke="white" strokeWidth="1.5" strokeLinecap="round" />
                  </svg>
                  Descargar PDF
                </button>
                <button
                  onClick={() => setOpen(false)}
                  style={{ display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: 34, height: 34, background: 'none', border: '1px solid #dfe3e8', borderRadius: 6, cursor: 'pointer', color: '#555D69', fontSize: 18, lineHeight: 1 }}
                >
                  ×
                </button>
              </div>
            </div>

            {/* ── Body ── */}
            <div style={{ padding: '24px 32px', color: '#15171b' }}>

              {/* KPIs */}
              <div style={{ display: 'flex', border: '1px solid #dfe3e8', borderRadius: 8, overflow: 'hidden', marginBottom: 24 }}>
                {([
                  { label: 'Total vehículos', val: totalVeh,   sub: 'todos los estudios' },
                  { label: 'En estudio',      val: totalEst,   sub: `${totalVeh > 0 ? Math.round(totalEst / totalVeh * 100) : 0}% del total` },
                  { label: 'Contratados',     val: totalContr, sub: `${totalVeh > 0 ? Math.round(totalContr / totalVeh * 100) : 0}% del total` },
                  { label: 'Tasa contratación', val: `${totalVeh > 0 ? Math.round((totalContr / totalVeh) * 100) : 0}%`, sub: 'sobre total vehículos', accent: true },
                ]).map((k, i) => (
                  <div key={k.label} style={{ flex: 1, padding: '14px 16px', borderRight: i < 3 ? '1px solid #dfe3e8' : 'none' }}>
                    <span style={{ fontSize: 9, letterSpacing: '0.1em', textTransform: 'uppercase', color: '#9aa1aa', display: 'block', marginBottom: 4 }}>{k.label}</span>
                    <span style={{ fontSize: 26, fontWeight: 760, letterSpacing: '-0.04em', color: k.accent ? '#1240cc' : '#15171b', lineHeight: 1, display: 'block' }}>{k.val}</span>
                    <span style={{ fontSize: 10, color: '#9aa1aa', display: 'block', marginTop: 2 }}>{k.sub}</span>
                  </div>
                ))}
              </div>

              {/* Resumen por categoría */}
              <SecTitle>Resumen por categoría</SecTitle>
              <table style={{ width: '100%', borderCollapse: 'collapse', marginBottom: 4 }}>
                <thead>
                  <tr>
                    {(['Categoría', 'En estudio', 'Ofertados', 'Contratados', 'Total', 'Distribución', 'Tasa contr.'] as const).map(h => (
                      <th key={h} style={{ fontSize: 9, letterSpacing: '0.08em', textTransform: 'uppercase', color: '#9aa1aa', padding: '7px 10px', borderBottom: '1px solid #dfe3e8', textAlign: h === 'Categoría' ? 'left' : 'center', fontWeight: 600 }}>
                        {h}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {stats.map(c => {
                    const t   = c.total > 0 ? Math.round((c.contratada / c.total) * 100) : 0;
                    const pct = totalVeh > 0 ? Math.round((c.total / totalVeh) * 100) : 0;
                    return (
                      <tr key={c.categoria}>
                        <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5' }}>
                          <strong style={{ display: 'block', fontSize: 13, fontWeight: 600, color: '#15171b' }}>{c.categoria}</strong>
                          <span style={{ fontSize: 10, color: '#9aa1aa' }}>{c.subtitulo}</span>
                        </td>
                        <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13 }}>{c.estudio}</td>
                        <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13 }}>{c.ofertada}</td>
                        <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13, fontWeight: 600 }}>{c.contratada}</td>
                        <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13, fontWeight: 700 }}>{c.total}</td>
                        <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13 }}>{pct}%</td>
                        <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13, fontWeight: 700, color: '#1240cc' }}>{t}%</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>

              {/* Detalle por tipología */}
              <SecTitle>Detalle por tipología</SecTitle>
              {stats.map((c, i) => {
                const t = c.total > 0 ? Math.round((c.contratada / c.total) * 100) : 0;
                return (
                  <div key={c.categoria} style={{ marginBottom: 20 }}>
                    <div style={{ borderLeft: `3px solid ${CAT_ACCENT[i] ?? '#1240cc'}`, background: '#f7f9fc', padding: '8px 14px', marginBottom: 8, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                      <strong style={{ fontSize: 12, fontWeight: 700, color: '#15171b' }}>{c.categoria}</strong>
                      <span style={{ fontSize: 10, color: '#555D69' }}>{c.total} vehículos · {t}% contratación</span>
                    </div>
                    <table style={{ width: '100%', borderCollapse: 'collapse' }}>
                      <thead>
                        <tr>
                          {(['Tipología', 'En estudio', 'Ofertados', 'Contratados', 'Total', '% s/ cat.'] as const).map(h => (
                            <th key={h} style={{ fontSize: 9, letterSpacing: '0.08em', textTransform: 'uppercase', color: '#9aa1aa', padding: '6px 10px', borderBottom: '1px solid #dfe3e8', borderTop: '1px solid #dfe3e8', textAlign: h === 'Tipología' ? 'left' : 'center', fontWeight: 600 }}>
                              {h}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {c.tipologias.map(tip => {
                          const pct = c.total > 0 ? Math.round((tip.total / c.total) * 100) : 0;
                          return (
                            <tr key={tip.tipologia}>
                              <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', fontSize: 13, fontWeight: 600, color: '#15171b' }}>{tip.tipologia}</td>
                              <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13 }}>{tip.estudio}</td>
                              <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13, color: '#555D69' }}>{tip.ofertada}</td>
                              <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13, fontWeight: 600 }}>{tip.contratada}</td>
                              <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13, fontWeight: 700 }}>{tip.total}</td>
                              <td style={{ padding: '10px', borderBottom: '1px solid #f0f2f5', textAlign: 'center', fontSize: 13, color: '#555D69' }}>{pct}%</td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                );
              })}

              {/* Metodología */}
              <div style={{ background: '#f7f9fc', border: '1px solid #dfe3e8', borderRadius: 8, padding: '14px 16px', marginTop: 8 }}>
                <div style={{ fontSize: 9, fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.12em', color: '#9aa1aa', marginBottom: 10 }}>Cómo se calculan los porcentajes</div>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px 24px' }}>
                  {[
                    { label: 'Tasa contratación (KPI global)',  code: 'contratados / total_vehículos × 100', desc: `Ej: ${totalContr} / ${totalVeh} = ${totalVeh > 0 ? Math.round((totalContr / totalVeh) * 100) : 0}%` },
                    { label: 'Tasa contr. por categoría',       code: 'contratados_cat / total_cat × 100',   desc: 'Solo vehículos de esa categoría' },
                    { label: '% s/ categoría (tipología)',      code: 'total_tip / total_cat × 100',         desc: 'Peso de la tipología dentro de su categoría' },
                    { label: 'Fuente de datos',                 code: 'trabajoRows de todas las carpetas',   desc: 'Clasificado por tipo_vehiculo · sin tipo → Sin clasificar' },
                  ].map(f => (
                    <div key={f.label}>
                      <div style={{ fontSize: 11, fontWeight: 600, color: '#15171b', marginBottom: 2 }}>{f.label}</div>
                      <div style={{ fontSize: 10, color: '#1240cc', fontFamily: 'monospace', background: '#edf0f7', padding: '2px 6px', borderRadius: 3, display: 'inline-block' }}>{f.code}</div>
                      <div style={{ fontSize: 10, color: '#9aa1aa', marginTop: 2 }}>{f.desc}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* ── Footer ── */}
            <div style={{ borderTop: '1px solid #dfe3e8', padding: '12px 32px', display: 'flex', justifyContent: 'space-between' }}>
              <span style={{ fontSize: 10, color: '#9aa1aa' }}>ORION · {new Date().toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' })}</span>
              <span style={{ fontSize: 10, color: '#9aa1aa' }}>Datos: todas las carpetas del período</span>
            </div>

          </div>
        </div>,
        document.body,
      )}
    </>
  );
}
